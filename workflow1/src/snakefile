# --- 1. 加载配置文件 ---
configfile: "/opt/scRNA_workflow/workflow1/src/config/config.yaml"

# --- 2. 工作流文件 ---
include: "workflow/rules/0_preprocess.smk"
include: "workflow/rules/1_read_data.smk"
include: "workflow/rules/2_quality_control.smk"
include: "workflow/rules/3_doublet_detection.smk"
include: "workflow/rules/4_filtering.smk"
include: "workflow/rules/5_normalization.smk"
include: "workflow/rules/6_batch_correction.smk"
include: "workflow/rules/7_feature_selection.smk"
include: "workflow/rules/8_clustering.smk"
include: "workflow/rules/9_annotation.smk"
include: "workflow/rules/10_differential.smk"
include: "workflow/rules/11_enrich.smk"
include: "workflow/rules/12_monocle3.smk"
include: "workflow/rules/3.5_doublet_visualization.smk"
include: "workflow/rules/13_cellchat.smk"

# --- 3. 基础阶段目标 ---
QC_OUTPUTS = [
    config["output"]["results"]["qc"] + "/aggregated_qc_report.pdf",
]

DOUBLET_OUTPUTS = [
    config["output"]["results"]["doublets"] + "/all_samples_doublet_umap.pdf",
]

ANNOTATION_OUTPUTS = [
    config["output"]["results"]["annotation"] + "/seurat_final_annotated.rds",
    config["output"]["results"]["annotation"] + "/reports/umap_final_annotated.pdf",
    config["output"]["results"]["annotation"] + "/reports/celltype_composition.pdf",
    config["output"]["results"]["annotation"] + "/spreadsheets/celltype_composition.csv",
    config["output"]["results"]["annotation"] + "/reports/marker_gene_heatmap.pdf",
]

MONOCLE3_OUTPUTS = [
    config["output"]["results"]["monocle3"] + "/cds_object.rds",
    config["output"]["results"]["monocle3"] + "/trajectory_summary.rds",
    config["output"]["results"]["monocle3"] + "/trajectory_summary.txt",
    config["output"]["results"]["monocle3"] + "/trajectory_dependent_genes.csv",
    config["output"]["results"]["monocle3"] + "/gene_modules.csv",
    config["output"]["results"]["monocle3"] + "/gene_modules_summary.csv",
]

DOWNSTREAM_OUTPUTS = [
    config["output"]["results"]["differential"] + "/reports/de_volcano_plots.pdf",
    config["output"]["results"]["differential"] + "/reports/de_heatmap.pdf",
    config["output"]["results"]["differential"] + "/spreadsheets/top_de_genes_summary.csv",
    config["output"]["results"]["enrichment"] + "/enrichment_summary.csv",
    config["output"]["results"]["enrichment"] + "/enrichment_summary.txt",
    config["output"]["results"]["enrichment"] + "/enrichment_results_all.rds",
    config["output"]["results"]["enrichment"] + "/unmapped_genes.csv",
    config["output"]["results"]["enrichment"] + "/GO_visualization.done",
    config["output"]["results"]["enrichment"] + "/KEGG_visualization.done",
    config["output"]["results"]["cellchat"] + "/spreadsheets/LR_pairs_all.csv",
    config["output"]["results"]["cellchat"] + "/plots/network/interaction_heatmap_weight.pdf",
    config["output"]["results"]["cellchat"] + "/plots/pathways/signaling_role_scatter.pdf",
    config["output"]["results"]["cellchat"] + "/spreadsheets/centrality_scores.csv",
] + MONOCLE3_OUTPUTS

# --- 4. 单阶段目标 ---
rule qc_all:
    input:
        QC_OUTPUTS

rule trajectory_all:
    input:
        MONOCLE3_OUTPUTS

rule downstream_all:
    input:
        DOWNSTREAM_OUTPUTS

# --- 5. Seurat 分阶段 all 目标 ---
# 这些目标只给 run_workflow 的 seurat 模式使用。
# 作用是避免 seurat 输入阶段调用全局 rule all 后，错误地回头寻找 fastq/read_data/qc 输入。

rule seurat_filtering_all:
    input:
        ANNOTATION_OUTPUTS + DOWNSTREAM_OUTPUTS

rule seurat_normalization_all:
    input:
        ANNOTATION_OUTPUTS + DOWNSTREAM_OUTPUTS

rule seurat_clustering_all:
    input:
        ANNOTATION_OUTPUTS + DOWNSTREAM_OUTPUTS

rule seurat_annotation_all:
    input:
        DOWNSTREAM_OUTPUTS

# --- 6. 全流程目标 ---
rule all:
    default_target: True
    input:
        QC_OUTPUTS + DOUBLET_OUTPUTS + ANNOTATION_OUTPUTS + DOWNSTREAM_OUTPUTS
    message:
        "全流程分析完成！"
